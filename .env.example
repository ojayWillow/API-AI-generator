# Copy this file to .env (same folder) and fill in your key.
# Never commit .env - it is in .gitignore.

# Required. Create one at https://kie.ai/api-key and add billing ($5 is plenty to test).
KIE_API_KEY=your_kie_api_key_here

# Optional. Where images, clips, sidecar JSON and ledger.json are saved.
# Default: the generations/ folder inside this skill.
# GENERATIONS_DIR=C:\Users\you\Videos\generations

# Optional spend caps in USD. The script refuses runs that would exceed them
# unless --override-cap is passed after the user explicitly agrees.
SESSION_CAP_USD=10
MONTHLY_CAP_USD=50
